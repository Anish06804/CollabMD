# Root-level convenience variables (copy into backend/.env)

# PostgreSQL connection string (local docker, Neon, Supabase, Render...)
DATABASE_URL=postgresql://anish:biswas200@localhost:5432/docmaster


# Port the backend HTTP + WebSocket server listens on
PORT=4000

# Allowed CORS origin for the frontend (Vite dev server)
FRONTEND_URL=http://localhost:5173

# Optional: path to a system Chrome/Chromium for PDF export.
# If unset, Puppeteer uses its bundled Chrome (downloaded on install).
# Windows example: C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=
